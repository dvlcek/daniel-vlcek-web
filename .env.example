# A2 security requirements (server-only; never prefix secrets with NEXT_PUBLIC).
# Keep existing database/email/calendar/admin environment configuration as well.
SECURITY_RATE_LIMIT_SECRET=
# Comma-separated exact origins; include each approved production/preview origin.
SECURITY_ALLOWED_ORIGINS=https://danielvlko.com
# Set to vercel ONLY on Vercel ingress that overwrites x-vercel-forwarded-for.
# Otherwise leave blank: all untrusted clients share a restrictive network quota.
SECURITY_TRUST_PROXY=
# Existing DATABASE_URL/DIRECT_URL are used for durable security storage/migrations.
# Existing CRON_SECRET (32+ random characters) protects /api/cron/security-cleanup.
